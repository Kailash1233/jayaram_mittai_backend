# Supabase PostgreSQL — paste the full connection string from:
# Supabase Dashboard → Settings → Database → Connection string → URI
DATABASE_URL=

# JWT — must match the variable names read in auth.service.ts
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRY=

JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRY=

# App
PORT=
NODE_ENV=

# Schema auto-sync for TypeORM (admin tables). Keep false against Supabase.
DB_SYNCHRONIZE=false

# Supabase JS client (catalog, orders, OTP) — copy from your existing jayaram_mittai_backend .env
SUPABASE_URL=
SUPABASE_KEY=
# Secret (service role) key — admin orders/analytics only. Bypasses RLS: server-side only, never ship to a client.
SUPABASE_SECRET_KEY=

# Supabase secret (service role) key — Settings → API Keys → Secret key.
# Used ONLY to create orders and record payments. Never expose to a frontend.
SUPABASE_SECRET_KEY=

# Razorpay — Dashboard → Account & Settings → API Keys (test keys: rzp_test_…)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay — Dashboard → Webhooks → the secret you set on the webhook
RAZORPAY_WEBHOOK_SECRET=

# CORS — comma-separated origins, or * for all
CORS_ORIGIN=*

# Supabase PostgreSQL — paste the full connection string from:
# Supabase Dashboard → Settings → Database → Connection string → URI
DATABASE_URL=

# JWT — must match the variable names read in auth.service.ts
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRY=

JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRY=

# App
PORT=
NODE_ENV=

# Schema auto-sync for TypeORM (admin tables). Keep false against Supabase.
DB_SYNCHRONIZE=false

# Supabase JS client (catalog, orders, OTP) — copy from your existing jayaram_mittai_backend .env
SUPABASE_URL=
SUPABASE_KEY=

# CORS — comma-separated origins, or * for all
CORS_ORIGIN=*
